{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Example: More aggressive updates",
  "extends": ["github>miccy/renovate-config"],
  "schedule": ["at any time"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": null,
  "packageRules": [
    {
      "description": "Top-level minimumReleaseAge cannot lift the inherited npm rule -- a packageRule outranks it, so drop the floor here too",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": null
    }
  ]
}
